         <property name="styleSheet">
          <string notr="true">QSlider {
    padding-left: 25px;
}
QSlider::groove:horizontal { 
	border: 1px solid gray;
	height: 2px; 
	left: 15px; 
	right: 10px; 
} 
QSlider::handle:horizontal { 
	border: 1px solid gray; 
	background:white;
	border-radius: 5px;
	width: 10px; 
	height: 10px; 
	margin: -5px; 
} 
QSlider::sub-page:horizontal{ 
	background: rgb(0, 255, 0); 
}</string>
