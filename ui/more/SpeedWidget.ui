         <property name="styleSheet">
          <string notr="true">#m_radCustom {
    background-color: transparent;
    text-align: left;
    color: #333333;
    padding: 0px 5px;
    border: none;
    spacing: 5px; 
}
#m_radCustom::indicator {
    width: 18px;
    height: 18px;
    subcontrol-position: center left; 
    margin-right: 10px;
}
#m_radCustom::indicator:unchecked {
    image: none; 
}
#m_radCustom::indicator:checked {
    image: url(:/XPlayer/res/selected.png); 
}
#m_radCustom:hover {
    background-color: #F5F5F5;
    border-radius: 6px; 
}</string>
